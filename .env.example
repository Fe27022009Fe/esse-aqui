# Copie este arquivo para ".env.local" (desenvolvimento) e preencha com os
# valores do seu projeto Supabase (Project Settings > API).

# URL do projeto Supabase (pública, pode ficar no navegador)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# anon/public key (pública, pode ficar no navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-a-anon-key-aqui

# service_role key (SECRETA — nunca use NEXT_PUBLIC_ aqui, nunca vai ao navegador,
# só é usada dentro das rotas de API, no servidor)
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# Senha de acesso ao painel do administrador (defina a sua, mantenha em segredo)
ADMIN_PASSWORD=escolha-uma-senha-forte
